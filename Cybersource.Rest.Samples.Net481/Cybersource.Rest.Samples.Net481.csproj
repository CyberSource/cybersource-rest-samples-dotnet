<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Source/**/*.cs" LinkBase="Source" />
    <Compile Include="../Shared/LogConfiguration/*.cs" LinkBase="LogConfiguration" />
    <Compile Include="../Shared/HttpClientConfiguration/*.cs" LinkBase="HttpClientConfiguration" />
    <Compile Include="../Shared/SerializationConfiguration/*.cs" LinkBase="SerializationConfiguration" />
    <None Include="../Shared/Source/Resource/*.*" LinkBase="Source/Resource" />
    <None Include="../Shared/Source/*.config" LinkBase="Source">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- On the .NET Framework legs, System.Text.Json pulls in System.Buffers/System.Memory/etc.
       Without binding redirects the older in-box assemblies (notably on net461) fail to unify,
       producing a System.Buffers FileLoadException. Emit the redirects into the test assembly's
       .config so the test host can load System.Text.Json. (.NET 5+ ignore these properties.) -->
  <PropertyGroup>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0162;CS0169;CS0219;CS0414;CS0618;CS1718;CA2200;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8621;CS8625;CS8629;CS8714;CS8765;CS8767</NoWarn>
    <NoWarn>$(NoWarn);SYSLIB0013;SYSLIB0051;SYSLIB0057;</NoWarn>
    <NoWarn>$(NoWarn);NUnit2005;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CyberSource.Authentication" Version="1.0.1" />
    <PackageReference Include="CyberSource.Rest.Client" Version="1.0.1" />
    <PackageReference Include="jose-jwt" Version="4.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
  </ItemGroup>

  <!-- Use the in-box System.Configuration assembly for ConfigurationManager. The NuGet package
       System.Configuration.ConfigurationManager ships the same type and collides with this
       framework assembly on .NET Framework, producing a CS0433 ambiguity. -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>
  </Project>
