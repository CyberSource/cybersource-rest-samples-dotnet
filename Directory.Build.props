<Project>

  <PropertyGroup>
    <SamplesRoot>$(MSBuildThisFileDirectory)</SamplesRoot>
    <SharedSampleConfigDir>$(SamplesRoot)Shared\Source\</SharedSampleConfigDir>
  </PropertyGroup>

  <!-- Use the combined shared App.config so both console logging (Logging:Console:*) and HTTP
       client (HttpClient:*) settings can be injected (via IOptions) into ConsoleLoggerFactory,
       SampleHttpClient, and SampleHttpClientFactory. MSBuild transforms it into <app>.exe.config
       in the build output, which ConfigurationManager.AppSettings reads at runtime. -->
  <PropertyGroup>
    <AppConfig>$(SharedSampleConfigDir)App.config</AppConfig>
  </PropertyGroup>

</Project>
