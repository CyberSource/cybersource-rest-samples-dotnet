<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    ============================================================================================
    Combined sample configuration for the CyberSource REST samples.
    ============================================================================================

    This file merges the two shared sample templates that used to live under
    Shared/LogConfiguration/App.config and Shared/HttpClientConfiguration/App.config into a
    single <appSettings> block:

      * Keys prefixed with "Logging:Console:" are bound into ConsoleLoggingOptions
        (Shared/LogConfiguration/ConsoleLoggingOptions.cs) and consumed by ConsoleLoggerFactory
        through the IOptions<ConsoleLoggingOptions> pattern.
      * Keys prefixed with "HttpClient:" are bound into SampleHttpClientOptions
        (Shared/HttpClientConfiguration/SampleHttpClientOptions.cs) and consumed by
        SampleHttpClient and SampleHttpClientFactory through the IOptions<SampleHttpClientOptions>
        pattern.

    Any key that is commented out (or left blank) falls back to the default value declared on
    the corresponding property, so you only need to uncomment the settings you actually want to
    override.

    Only a minimal, commonly used set is enabled in each section. All remaining options are
    documented and commented out so you can turn them on when needed.
  -->

  <appSettings>

    <!-- ============================================================================ -->
    <!-- ==                       CONSOLE LOGGING (Logging:Console:*)             == -->
    <!-- ============================================================================ -->

    <!-- ======================= ENABLED (minimal, commonly used) ======================= -->

    <!--
      MinimumLogLevel: the lowest severity that is emitted; anything below it is suppressed.
      Allowed values: Trace | Debug | Information | Warning | Error | Critical | None
      Default: Information
    -->
    <add key="Logging:Console:MinimumLogLevel" value="Debug" />

    <!--
      TimestampFormat: a DateTime format string prefixed to each entry.
      Leave blank/commented for no timestamp. Example: "yyyy-MM-dd HH:mm:ss "
      Default: (none)
    -->
    <add key="Logging:Console:TimestampFormat" value="yyyy-MM-dd HH:mm:ss " />

    <!--
      SingleLine: when true, the Simple formatter writes each entry on a single line.
      Only honored by the Simple formatter.
      Allowed values: true | false
      Default: false
    -->
    <add key="Logging:Console:SingleLine" value="true" />

    <!-- ======================= OPTIONAL (documented, disabled) ======================== -->

    <!--
      FormatterName: selects the console formatter.
      Allowed values: Simple | Systemd | Json
        Simple  - human readable output (supports colors and single-line mode)
        Systemd - output shaped for the systemd journal (no colors, single line)
        Json    - one structured JSON document per log entry
      Default: Simple
    -->
    <!--<add key="Logging:Console:FormatterName" value="Simple" />-->

    <!--
      IncludeScopes: when true, logging scopes are written alongside each entry.
      Allowed values: true | false
      Default: false
    -->
    <!-- <add key="Logging:Console:IncludeScopes" value="false" /> -->

    <!--
      UseUtcTimestamp: when true, timestamps are rendered in UTC instead of local time.
      Only relevant when TimestampFormat is set.
      Allowed values: true | false
      Default: false
    -->
    <!-- <add key="Logging:Console:UseUtcTimestamp" value="false" /> -->

    <!--
      ColorBehavior: controls ANSI color usage for the Simple formatter.
      Allowed values: Default | Enabled | Disabled
      Default: Default (colors when the console is not redirected)
    -->
    <!-- <add key="Logging:Console:ColorBehavior" value="Default" /> -->

    <!--
      LogToStandardErrorThreshold: entries at this level and above go to standard error
      instead of standard output. Leave commented to send everything to standard output.
      Allowed values: Trace | Debug | Information | Warning | Error | Critical
      Default: (none)
    -->
    <!-- <add key="Logging:Console:LogToStandardErrorThreshold" value="Error" /> -->

    <!--
      JsonIndented: when true, JSON output is pretty printed. Only honored by the Json formatter.
      Allowed values: true | false
      Default: false
    -->
    <!--<add key="Logging:Console:JsonIndented" value="false" />-->


    <!-- ============================================================================ -->
    <!-- ==                            HTTP CLIENT (HttpClient:*)                 == -->
    <!-- ============================================================================ -->

    <!-- ======================= ENABLED (minimal, commonly used) ======================= -->

    <!--
      TimeoutSeconds: overall request/response timeout, in seconds. Applies to the whole request
      including content download. Use a value <= 0 for an infinite timeout.
      Default: 100
    -->
    <add key="HttpClient:TimeoutSeconds" value="30" />

    <!--
      UserAgent: the value sent in the "User-Agent" request header on every call.
      Default: "CyberSourceRestSamples/1.0"
    -->
    <add key="HttpClient:UserAgent" value="CyberSourceRestSamples/1.0" />

    <!-- ======================= OPTIONAL (documented, disabled) ======================== -->

    <!--
      BaseAddress: absolute base URI prepended to every relative request URI. When blank, callers
      must always pass an absolute URI (this is the usual configuration for the CyberSource SDK,
      which supplies the endpoint through the merchant configuration).
      Default: (none)
    -->
    <!-- <add key="HttpClient:BaseAddress" value="https://apitest.cybersource.com/" /> -->

    <!--
      MaxResponseContentBufferSizeBytes: maximum number of bytes buffered when reading a response.
      Values <= 0 fall back to int.MaxValue (roughly 2 GB).
      Default: 2147483647
    -->
    <!-- <add key="HttpClient:MaxResponseContentBufferSizeBytes" value="2147483647" /> -->

    <!--
      AllowAutoRedirect: whether the handler follows HTTP redirect responses automatically.
      Allowed values: true | false
      Default: true
    -->
    <!-- <add key="HttpClient:AllowAutoRedirect" value="true" /> -->

    <!--
      MaxAutomaticRedirections: the maximum number of redirects that will be followed before the
      handler gives up. Only honored when AllowAutoRedirect is true.
      Default: 50
    -->
    <!-- <add key="HttpClient:MaxAutomaticRedirections" value="50" /> -->

    <!--
      AutomaticDecompression: which decompression methods are requested via "Accept-Encoding".
      Allowed values: None | GZip | Deflate | "GZip, Deflate"
      Default: None
    -->
    <!-- <add key="HttpClient:AutomaticDecompression" value="GZip, Deflate" /> -->

    <!--
      UseCookies: whether the handler stores and resends cookies across requests.
      Allowed values: true | false
      Default: true
    -->
    <!-- <add key="HttpClient:UseCookies" value="true" /> -->

    <!--
      PreAuthenticate: whether credentials are sent preemptively on the first request rather than
      waiting for a "401 Unauthorized" challenge.
      Allowed values: true | false
      Default: false
    -->
    <!-- <add key="HttpClient:PreAuthenticate" value="false" /> -->

    <!--
      UseProxy: whether the handler uses the system or configured proxy. Set to false to bypass
      all proxies entirely.
      Allowed values: true | false
      Default: true
    -->
    <!-- <add key="HttpClient:UseProxy" value="true" /> -->

    <!--
      ProxyAddress: absolute URI of the outbound proxy. Only honored when UseProxy is true.
      When blank the system proxy is used.
      Default: (none)
    -->
    <!-- <add key="HttpClient:ProxyAddress" value="http://proxy.corp.example.com:8080" /> -->

    <!--
      ProxyBypassOnLocal: whether requests to local (intranet) hosts skip the proxy above.
      Allowed values: true | false
      Default: true
    -->
    <!-- <add key="HttpClient:ProxyBypassOnLocal" value="true" /> -->

    <!--
      MaxConnectionsPerServer: maximum number of concurrent TCP connections allowed per remote
      server.
      Default: 2147483647
    -->
    <!-- <add key="HttpClient:MaxConnectionsPerServer" value="2147483647" /> -->

    <!--
      HandlerLifetimeMinutes: only used by SampleHttpClientFactory. The number of minutes a cached
      HttpClient (and its underlying handler) is reused before the factory rotates it, so DNS
      changes are picked up. Values <= 0 fall back to 2 minutes.
      Default: 2
    -->
    <!-- <add key="HttpClient:HandlerLifetimeMinutes" value="2" /> -->

  </appSettings>

</configuration>
